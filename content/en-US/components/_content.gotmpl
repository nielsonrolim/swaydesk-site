{{- /* One page per component with page = true in data/components.toml, drawn by layouts/components/page.html.
       The same file in the three languages. hugo.Data from Hugo 0.156 on, .Site.Data before (CI's 0.147). */ -}}
{{- $d := dict }}{{ if ge hugo.Version "0.156.0" }}{{ $d = hugo.Data }}{{ else }}{{ $d = .Site.Data }}{{ end }}
{{- $lang := lower .Site.Language.Lang }}
{{- range $d.components.components }}
{{- if .page }}
{{- $t := index . $lang }}
{{- if not $t }}{{ errorf "data/components.toml: %q has no [components.%s]" .id $lang }}{{ end }}
{{- $.AddPage (dict "path" .id "title" $t.name "kind" "page" "params" (dict "component" .id "crumb" (printf "components/%s" .id) "description" (plainify $t.text | truncate 150))) }}
{{- end }}
{{- end }}
